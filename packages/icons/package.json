{
	"private": false,
	"name": "@tokens-studio/icons",
	"version": "0.1.6",
	"description": "Tokens Studio: Internal icon library",
	"author": "jan@hyma.io",
	"type": "module",
	"exports": {
		"./*": {
			"import": "./dist/icons/*",
			"types": "./dist/icons/*"
		},
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf src/icons && rm -rf dist",
		"dev": "tsc --watch",
		"regenerate": "npm run clean && node generate-enum.js && npm run svgr",
		"svgr": "svgr --silent --config-file svgr.config.cjs assets",
		"format:eslint": "eslint . --fix",
		"lint": "npm run lint:eslint && npm run lint:types",
		"lint:eslint": "eslint .",
		"lint:types": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.4",
		"@svgr/cli": "^8.1.0",
		"@tokens-studio/configs": "^0.2.3",
		"change-case": "^5.4.4",
		"eslint": "^9.29.0",
		"typescript": "^5.8.3"
	}
}
